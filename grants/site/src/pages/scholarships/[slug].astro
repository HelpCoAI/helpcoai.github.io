---
import Base from "../../layouts/Base.astro";
import data from "../../data/awards.json";
import {
  amountLabel, awardFaqs, breadcrumbs, grantDescription, grantNode,
  orgNode, siteNode,
} from "../../lib/schema";

export function getStaticPaths() {
  const RANK: Record<string, number> = { school: 0, city: 1, county: 2, state: 3, national: 4 };
  return data.awards.map((award: any) => {
    // Related awards give every page outbound context and give crawlers a path
    // to the deep pages that nothing else links to. Same county first, then
    // same sponsor -- both are relationships a reader would actually follow.
    const related = data.awards
      .filter((a: any) =>
        a.slug !== award.slug &&
        (a.counties?.some((c: string) => award.counties?.includes(c)) ||
         (a.sponsor && a.sponsor === award.sponsor)))
      .sort((a: any, b: any) => (RANK[a.geo_scope] ?? 3.5) - (RANK[b.geo_scope] ?? 3.5))
      .slice(0, 4);
    return { params: { slug: award.slug }, props: { award, related } };
  });
}
const { award, related } = Astro.props;
const site = (Astro.site ?? new URL("http://localhost:4321")).href;
const amount = amountLabel(award);

const LABELS: Record<string, string> = {
  gpa_min: "Minimum GPA", gpa_scale: "GPA scale", income_max: "Household income cap",
  num_awards: "Awards per year", renewal_years: "Renewable for (years)",
  recommendation_letters: "Letters of recommendation", gender: "Gender",
  military_affiliation: "Military affiliation", employer_affiliation: "Employer",
  beneficiary_scope: "How you're selected", class_year: "Year in school",
  enrollment_status: "Enrolment", counties: "Counties", cities: "Cities",
  high_schools: "High schools", majors: "Fields of study", activities: "Activities",
  clubs_organizations: "Clubs", college_plan: "Type of school",
  citizenship: "Citizenship", heritage: "Heritage",
  destination_institutions: "Where you can attend",
};
const FLAGS: Record<string, string> = {
  need_based: "Considers financial need", merit_based: "Considers merit",
  first_generation: "First-generation students", disability: "Disability-related",
  residency_required: "Residency required", renewable: "Renewable",
  essay_required: "Essay required", transcript_required: "Transcript required",
  fafsa_required: "FAFSA required",
};

const criteria = Object.entries(LABELS)
  .map(([k, label]) => {
    const v = (award as any)[k];
    if (v == null || v === "" || (Array.isArray(v) && v.length === 0)) return null;
    return { label, value: Array.isArray(v) ? v.join(", ") : String(v) };
  })
  .filter(Boolean) as { label: string; value: string }[];

const flags = Object.entries(FLAGS)
  .filter(([k]) => (award as any)[k] === true || (award as any)[k] === "True")
  .map(([, label]) => label);

const effort = award.estimated_effort_minutes
  ? `About ${award.estimated_effort_minutes} minutes of work, based on what the sponsor asks for.`
  : null;

const countySlug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const trail = [
  { name: "Home", path: "/" },
  { name: "All awards", path: "/scholarships/" },
  ...(award.counties?.[0]
    ? [{ name: `${award.counties[0]} County`, path: `/florida/${countySlug(award.counties[0])}/` }]
    : []),
  { name: award.name, path: `/scholarships/${award.slug}/` },
];

const graph = [
  orgNode(site), siteNode(site), grantNode(site, award),
  breadcrumbs(site, trail), awardFaqs(award),
].filter(Boolean);

// Answer-first: the opening sentence answers "what is this and can I get it?"
// before any narrative, because that sentence is what gets extracted.
const answer = grantDescription(award);
---
<Base title={`${award.name}${award.sponsor ? ` | ${award.sponsor}` : ""}`}
      description={answer.slice(0, 300)} indexable={award.indexable}>
  <script type="application/ld+json" slot="head"
          set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />

  <article class="detail">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/scholarships/">All awards</a>
      {award.counties?.[0] && (
        <> › <a href={`/florida/${countySlug(award.counties[0])}/`}>{award.counties[0]} County</a></>
      )}
    </nav>

    <h1>{award.name}</h1>
    {award.sponsor && (
      <p class="sponsor">
        Offered by <a href={`/sponsors/${award.sponsor.toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 70)}/`}>{award.sponsor}</a>
      </p>
    )}

    <p class="answer">{answer}</p>

    <div class="headline">
      <div><span class="k">Award</span><span class="v">{amount ?? "Not published"}</span></div>
      <div><span class="k">Deadline</span><span class="v">{award.deadline ?? "Not published"}</span></div>
      {award.num_awards && <div><span class="k">Given each year</span><span class="v">{award.num_awards}</span></div>}
    </div>

    {effort && <p class="effort">{effort}</p>}
    {flags.length > 0 && <ul class="flags">{flags.map((f) => <li>{f}</li>)}</ul>}

    {criteria.length > 0 && (
      <>
        <h2>Who can apply</h2>
        <dl class="criteria">
          {criteria.map((c) => <div><dt>{c.label}</dt><dd>{c.value}</dd></div>)}
        </dl>
      </>
    )}

    <h2>What the sponsor says</h2>
    <blockquote class="raw" cite={award.source_url}>{award.eligibility_raw}</blockquote>
    <p class="note">
      Quoted from <a href={award.source_url} rel="nofollow noopener">the sponsor's own page</a>,
      unedited. Where our summary above and this text disagree, this text is
      correct. Tell us and we'll fix the summary.
    </p>

    {award.source_url && (
      <p class="apply">
        <a class="btn" href={award.source_url} rel="nofollow noopener" target="_blank">
          Apply at {award.source_org || "the sponsor's site"} →
        </a>
      </p>
    )}

    <p class="verified">
      Last checked {award.last_verified}. Deadlines change without notice, so
      confirm with the sponsor before you rely on one.
    </p>

    {related.length > 0 && (
      <>
        <h2>Other awards {award.counties?.[0] ? `in ${award.counties[0]} County` : "from this sponsor"}</h2>
        <ul class="related">
          {related.map((r: any) => (
            <li>
              <a href={`/scholarships/${r.slug}/`}>{r.name}</a>
              {amountLabel(r) && <span>, {amountLabel(r)}</span>}
            </li>
          ))}
        </ul>
      </>
    )}
  </article>
</Base>
