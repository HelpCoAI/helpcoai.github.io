---
import Base from "../../layouts/Base.astro";
import AwardCard from "../../components/AwardCard.astro";
import data from "../../data/awards.json";
import {
  amountLabel, breadcrumbs, faqNode, money, orgNode, siteNode,
} from "../../lib/schema";

// The helpers live INSIDE getStaticPaths deliberately. Astro evaluates it in an
// isolated scope, so a module-level const is not in scope there and the build
// fails with "locality is not defined" -- at build time only, which is exactly
// the kind of break that would otherwise be found in CI rather than here.
export function getStaticPaths() {
  const RANK: Record<string, number> = { school: 0, city: 1, county: 2, state: 3, national: 4 };
  const locality = (a: any) => RANK[a.geo_scope] ?? 3.5;   // unstated sits mid-pack

  return data.counties.map((county: any) => ({
    params: { county: county.slug },
    props: {
      county,
      awards: data.awards
        .filter((a: any) => county.award_slugs.includes(a.slug))
        .sort((a: any, b: any) =>
          locality(a) - locality(b) ||
          Number(b.amount_max ?? 0) - Number(a.amount_max ?? 0)),
      // Nearby counties give crawlers and readers a lateral path, and stop each
      // county page being a dead end reachable only from the index.
      others: data.counties
        .filter((c: any) => c.slug !== county.slug && c.indexable)
        .sort((a: any, b: any) => b.count - a.count).slice(0, 5),
    },
  }));
}
const { county, awards, others } = Astro.props;
const site = (Astro.site ?? new URL("http://localhost:4321")).href;

const known = awards.filter((a: any) => a.amount_max).map((a: any) => Number(a.amount_max));
const total = known.reduce((s: number, n: number) => s + n, 0);
const withDeadline = awards.filter((a: any) => a.deadline);
// A bare total invites "there is $134,750 waiting for me". Pair it with what one
// recipient actually receives so the sentence cannot be misread standing alone.
const each = known.slice().sort((a: number, b: number) => a - b);
const perAward = each.length
  ? (each[0] === each[each.length - 1]
      ? `$${each[0].toLocaleString()}`
      : `$${each[0].toLocaleString()} to $${each[each.length - 1].toLocaleString()}`)
  : null;
const local = awards.filter((a: any) => ["county", "city", "school"].includes(a.geo_scope));
// Deliberately the largest LOCAL award, not the largest award on the page. The
// unfiltered version answered "the largest scholarship for Pasco County
// students" with a $65,000 Horatio Alger award open to the entire country --
// true, useless, and exactly the national-database answer a student can already
// get anywhere. Worse, it is the sentence an answer engine would lift.
const biggest = [...local].sort(
  (a: any, b: any) => Number(b.amount_max ?? 0) - Number(a.amount_max ?? 0))[0];
const needBased = awards.filter((a: any) => a.need_based === true || a.need_based === "True");
// Counted as three states, never two. An award whose page never mentions an
// essay is UNKNOWN, not essay-free -- the same invariant the extraction and
// enrichment passes enforce. The first version of this FAQ counted 27 unknowns
// as "no essay required", which is precisely the failure the rest of the
// pipeline exists to prevent, reintroduced while optimising for extraction.
const essayYes = awards.filter((a: any) => a.essay_required === true || a.essay_required === "True");
const essayUnknown = awards.filter((a: any) => a.essay_required == null || a.essay_required === "");

// Assembled from counts, never written. Statistics-dense on purpose: the one
// piece of controlled evidence on generative-engine visibility found that
// adding concrete statistics and citing primary sources moved the needle 30-40%,
// while stylistic padding did not. Every number here is countable from the data
// on the page, so it is checkable rather than merely confident.
const summary =
  `${awards.length} scholarship${awards.length === 1 ? "" : "s"} are open to ${county.name} County students` +
  (total ? `. Together they award at least $${total.toLocaleString()} a year across all recipients${perAward ? `, with individual awards of ${perAward}` : ""}` : "") +
  `. ${local.length} of them are restricted to this county, a city inside it, or a single high school — ` +
  `awards the national databases generally do not carry. ${withDeadline.length} have a published deadline.`;

const faqs = faqNode([
  {
    q: `How many scholarships are available for ${county.name} County students?`,
    a: `${awards.length} that we have verified against the sponsor's own page, ${local.length} of which are restricted to ${county.name} County, a city inside it, or a single high school.`,
  },
  biggest && money(biggest.amount_max) && {
    q: `What is the largest local scholarship in ${county.name} County?`,
    a: `${biggest.name}${biggest.sponsor ? `, from ${biggest.sponsor}` : ""}, at ${money(biggest.amount_max)}. It is restricted to this area rather than open nationally, so the applicant pool is a fraction of the size.`,
  },
  needBased.length > 0 && {
    q: `Are there need-based scholarships in ${county.name} County?`,
    a: `${needBased.length} of the ${awards.length} awards we list state that they consider financial need. Where a sponsor does not say, we leave the field blank rather than assume.`,
  },
  essayYes.length > 0 && {
    q: `Which ${county.name} County scholarships require an essay?`,
    a: `${essayYes.length} of the ${awards.length} awards state that an essay is required. The other ${essayUnknown.length} do not mention one, which means the sponsor did not publish that detail — not that there is no essay. Check with the sponsor before assuming.`,
  },
  {
    q: `Why apply for local scholarships instead of national ones?`,
    a: `The applicant pool. A national award can draw tens of thousands of applicants for a few hundred places, while an award limited to one county or one high school is competing against a graduating class. ${local.length} of the ${awards.length} awards on this page are limited that way.`,
  },
]);

const itemList = {
  "@type": "ItemList",
  name: `Scholarships for ${county.name} County, Florida students`,
  numberOfItems: awards.length,
  itemListElement: awards.slice(0, 50).map((a: any, i: number) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/scholarships/${a.slug}/`, site).href,
    name: a.name,
  })),
};

const graph = [
  orgNode(site), siteNode(site), itemList,
  breadcrumbs(site, [
    { name: "Home", path: "/" },
    { name: "Florida counties", path: "/florida/" },
    { name: `${county.name} County`, path: `/florida/${county.slug}/` },
  ]),
  faqs,
].filter(Boolean);
---
<Base
  title={`${county.name} County, Florida scholarships (${awards.length} local awards)`}
  description={summary.slice(0, 300)}
  indexable={county.indexable}
>
  <script type="application/ld+json" slot="head"
          set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/florida/">Florida counties</a> › {county.name} County
  </nav>

  <h1>{county.name} County scholarships</h1>
  <p class="lede">{summary}</p>

  {!county.indexable && (
    <p class="thin">
      We have only found {awards.length} award{awards.length === 1 ? "" : "s"} here so far.
      This page is published for anyone who needs it but is not offered to search
      engines until it is worth finding. Know one we are missing?
      <a href="/submit/">Tell us</a>.
    </p>
  )}

  <ul class="grid">
    {awards.map((a: any) => <li><AwardCard award={a} /></li>)}
  </ul>

  {faqs && (
    <section class="faq">
      <h2>Common questions</h2>
      <dl>
        {faqs.mainEntity.map((q: any) => (
          <><dt>{q.name}</dt><dd>{q.acceptedAnswer.text}</dd></>
        ))}
      </dl>
    </section>
  )}

  {others.length > 0 && (
    <section>
      <h2>Nearby counties</h2>
      <ul class="counties">
        {others.map((c: any) => (
          <li><a href={`/florida/${c.slug}/`}><strong>{c.name} County</strong><span>{c.count} awards</span></a></li>
        ))}
      </ul>
    </section>
  )}
</Base>
