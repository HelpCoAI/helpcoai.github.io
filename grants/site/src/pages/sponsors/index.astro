---
import Base from "../../layouts/Base.astro";
import data from "../../data/awards.json";
const sponsors = [...data.sponsors].sort((a: any, b: any) => b.count - a.count || a.name.localeCompare(b.name));
---
<Base
  title="Scholarship sponsors"
  description={`The ${data.stats.sponsors} organisations funding the awards in our index.`}
  indexable={true}
>
  <h1>Sponsors</h1>
  <p class="lede">{data.stats.sponsors} organisations fund the awards we list.</p>
  <ul class="counties">
    {sponsors.map((s: any) => (
      <li><a href={`/sponsors/${s.slug}/`}><strong>{s.name}</strong><span>{s.count}</span></a></li>
    ))}
  </ul>
</Base>
